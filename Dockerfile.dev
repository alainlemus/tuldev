# syntax=docker/dockerfile:1

FROM composer:2 AS composer-deps
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-scripts --ignore-platform-reqs

# .npmrc fuerza legacy-peer-deps (bug de npm con Arborist): sin él falla `npm ci`.
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN npm run build

FROM php:8.4-fpm-alpine AS app
WORKDIR /var/www/html

# Misma arquitectura que Dockerfile.prod (ver docker/app/) para que el ambiente de
# pruebas pruebe lo mismo que va a producción. Diferencias a propósito: Xdebug, errores
# visibles, sin opcache y sin cachear config/rutas/vistas (SKIP_LARAVEL_CACHE).
ENV APP_ENV=local \
    APP_DEBUG=true \
    XDEBUG_MODE=off \
    SKIP_LARAVEL_CACHE=1 \
    VIEW_COMPILED_PATH=/var/www/html/bootstrap/cache/views

RUN apk add --no-cache \
        nginx \
        supervisor \
        su-exec \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libwebp-dev \
        libxml2-dev \
        libzip-dev \
        icu-dev \
        oniguruma-dev \
        linux-headers \
        $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_mysql bcmath gd zip intl mbstring pcntl \
    && pecl channel-update pecl.php.net \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug

# Xdebug queda instalado pero apagado (XDEBUG_MODE=off); se activa sin rebuild con
# XDEBUG_MODE=debug en las variables de Dokploy y el IDE en host.docker.internal:9003.
RUN { \
        echo 'upload_max_filesize=20M'; \
        echo 'post_max_size=20M'; \
        echo 'max_execution_time=300'; \
        echo 'memory_limit=512M'; \
        echo 'display_errors=On'; \
        echo 'error_reporting=E_ALL'; \
        echo 'opcache.enable=0'; \
    } > /usr/local/etc/php/conf.d/dev.ini \
    && { \
        echo 'xdebug.client_host=host.docker.internal'; \
        echo 'xdebug.start_with_request=yes'; \
        echo 'xdebug.discover_client_host=1'; \
    } > /usr/local/etc/php/conf.d/xdebug.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=composer-deps /app/vendor ./vendor

COPY . .
COPY --from=frontend-builder /app/public/build ./public/build

RUN mkdir -p bootstrap/cache/views \
    storage/logs \
    storage/app/public \
    storage/app/private/livewire-tmp \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views

# Los assets de Filament están en .gitignore y --no-scripts omite filament:upgrade:
# sin filament:assets el panel /admin se queda sin CSS ni JS.
RUN composer dump-autoload --optimize --no-scripts \
    && php artisan package:discover --ansi \
    && php artisan filament:assets

RUN ln -sfn ../storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwx storage bootstrap/cache

COPY docker/app/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/app/supervisord.conf /etc/supervisord.conf
COPY docker/app/entrypoint.sh /usr/local/bin/entrypoint
# nginx corre como www-data (igual que php-fpm): sin permiso sobre su carpeta temporal
# responde 500 a las peticiones de más de 16 KB antes de llegar a Laravel.
RUN chmod +x /usr/local/bin/entrypoint \
    && sed -i 's/^user nginx;/user www-data;/' /etc/nginx/nginx.conf \
    && mkdir -p /var/lib/nginx/tmp \
    && chown -R www-data:www-data /var/lib/nginx

EXPOSE 8000

# Ver docker/app/entrypoint.sh: migraciones y luego supervisor con nginx, php-fpm y
# los trabajadores de colas.
CMD ["/usr/local/bin/entrypoint"]
